# ── 프론트엔드 (Vite, 브라우저 노출됨 → 민감 키 금지) ──
# Supabase 프로젝트 설정 > API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# 간이 단일 비밀번호 인증 (PRD F-00)
VITE_DASHBOARD_PASSWORD=change-me

# ── 서버 전용 (Vercel Serverless / API Routes, 브라우저 비노출) ──
# Claude API 키 — 절대 VITE_ 접두사 붙이지 말 것
ANTHROPIC_API_KEY=sk-ant-...
# Claude 하루 최대 호출 횟수 안전장치 (PRD 제약사항 3)
CLAUDE_DAILY_LIMIT=20
# 서버용 Supabase URL (VITE_SUPABASE_URL 과 동일 값, 호출 카운트 기록용)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 서버에서 DB 쓰기용 (RLS 우회) — 노출 절대 금지
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
